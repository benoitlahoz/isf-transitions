{
  "name": "isf-transitions",
  "version": "3.3.0",
  "description": "Famous gl-transitions converted to ISF (Interactive Shader Format).",
  "author": "Benoît LAHOZ <info@benoitlahoz.io>",
  "license": "MIT AND BSD-2-Clause AND BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benoitlahoz/isf-transitions.git"
  },
  "type": "module",
  "main": "transitions.mjs",
  "types": "transitions.d.ts",
  "exports": {
    ".": {
      "types": "./transitions.d.ts",
      "default": "./transitions.mjs"
    },
    "./catalog": {
      "types": "./catalog.d.ts",
      "default": "./catalog.mjs"
    },
    "./converted/*": "./converted/*",
    "./package.json": "./package.json"
  },
  "files": [
    "converted",
    "transitions",
    "transitions.mjs",
    "transitions.d.ts",
    "catalog.mjs",
    "catalog.d.ts",
    "install.mjs",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "!**/.private*",
    "!**/.DS_Store"
  ],
  "scripts": {
    "convert": "node index.mjs",
    "copy": "node install.mjs",
    "test": "node --test *.test.mjs"
  },
  "devDependencies": {
    "@isf-studio/isf-renderer": "^1.0.1",
    "esbuild": "^0.28.2",
    "interactive-shader-format": "^2.8.1",
    "isfjs": "^1.0.2"
  }
}
